# ==============================================================================
# Bun Atelier Backend Environment Variables (TEMPLATE)
# Salin file ini menjadi .env lalu isi nilainya:
# cp .env.example .env
# ==============================================================================

PORT=3000
NODE_ENV=development

# Google Gemini API Key (Dapatkan API Key gratis di https://aistudio.google.com/)
# Jangan pernah membagikan API key ini atau commit ke repository git!
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash

# Supabase PostgreSQL Database (Opsional untuk fitur auth & catalog)
DATABASE_URL=postgresql://postgres.placeholder:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.placeholder:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# JWT Authentication Secrets
JWT_SECRET=bun_atelier_dev_jwt_secret_key_worthy_of_mess_2026
JWT_REFRESH_SECRET=bun_atelier_dev_refresh_jwt_key_2026
JWT_EXPIRES_IN=7d

# ==============================================================================
# Blockchain EVM Ledger Configuration (Ethereum Sepolia Testnet)
# ==============================================================================
# Kosongkan untuk menjalankan mode SIMULATION_FALLBACK (prototype mahasiswa aman tanpa gas fee)
# Isi dengan credentials Sepolia asli untuk mengaktifkan pencatatan dan verifikasi on-chain live:
BLOCKCHAIN_NETWORK=sepolia
BLOCKCHAIN_CHAIN_ID=11155111
BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
BLOCKCHAIN_PRIVATE_KEY=your_backend_wallet_private_key_without_0x
BLOCKCHAIN_CONTRACT_ADDRESS=0xYourDeployedContractAddress
